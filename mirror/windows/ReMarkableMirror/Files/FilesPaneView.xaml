<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ReMarkableMirror.Files.FilesPaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="320"
    HorizontalAlignment="Left"
    Loaded="FilesPaneView_Loaded"
    RequestedTheme="Light"
    mc:Ignorable="d">

    <!-- Keep the pane visually self-contained and reusable. -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#202124" />
        <SolidColorBrush x:Key="MutedBrush" Color="#5F6066" />
        <SolidColorBrush x:Key="StageBrush" Color="#EDECE7" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3858E9" />

        <Style x:Key="LightRoundToolButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="19" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="#FFE4E3DE" />
            <Setter Property="BorderBrush" Value="#FFC8C7C1" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Border
        x:Name="PaneSurface"
        Width="320"
        HorizontalAlignment="Left"
        Padding="14,2,14,14"
        Background="{StaticResource StageBrush}"
        BorderBrush="#FFCFCFC9"
        BorderThickness="0,1,1,1"
        CornerRadius="0,24,24,0">
        <Border
            Padding="14"
            Background="Transparent"
            BorderBrush="#FFCFCFC9"
            BorderThickness="1,0,0,0"
            CornerRadius="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <TextBlock
                        FontSize="21"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource InkBrush}"
                        Text="Files" />
                    <Button
                        x:Name="CloseButton"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Close files"
                        Click="CloseButton_Click"
                        Style="{StaticResource LightRoundToolButtonStyle}"
                        ToolTipService.ToolTip="Close files">
                        <FontIcon FontSize="13" Glyph="&#xE711;" />
                    </Button>
                </Grid>

                <TextBlock
                    Grid.Row="1"
                    Margin="0,3,0,14"
                    FontSize="13"
                    Foreground="{StaticResource MutedBrush}"
                    Text="Move documents in and out naturally." />

                <Border
                    x:Name="DropTarget"
                    Grid.Row="2"
                    MinHeight="104"
                    AllowDrop="False"
                    Background="#FFFAF9F5"
                    BorderBrush="#FFC9C8C1"
                    BorderThickness="1"
                    CornerRadius="14"
                    DragEnter="DropTarget_DragEnter"
                    DragLeave="DropTarget_DragLeave"
                    DragOver="DropTarget_DragOver"
                    Drop="DropTarget_Drop">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="7">
                        <Border
                            x:Name="DropTargetIconSurface"
                            Width="40"
                            Height="40"
                            Background="#FFDDE2FF"
                            CornerRadius="20">
                            <FontIcon
                                x:Name="DropTargetIcon"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="18"
                                Foreground="{StaticResource AccentBrush}"
                                Glyph="&#xE898;" />
                        </Border>
                        <TextBlock
                            x:Name="DropTargetTitle"
                            HorizontalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource InkBrush}"
                            Text="Connect to send" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource MutedBrush}"
                            Text="PDF or EPUB" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="LibraryBackButton"
                            Width="30"
                            Height="30"
                            AutomationProperties.Name="Back to previous folder"
                            Click="LibraryBackButton_Click"
                            IsEnabled="False"
                            Style="{StaticResource LightRoundToolButtonStyle}">
                            <FontIcon FontSize="12" Glyph="&#xE72B;" />
                        </Button>
                        <TextBlock
                            x:Name="LibraryLocationText"
                            Grid.Column="1"
                            Margin="9,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource InkBrush}"
                            Text="My files"
                            TextTrimming="CharacterEllipsis" />
                        <Button
                            x:Name="LibraryRefreshButton"
                            Grid.Column="2"
                            Width="30"
                            Height="30"
                            AutomationProperties.Name="Refresh library"
                            Click="LibraryRefreshButton_Click"
                            IsEnabled="False"
                            Style="{StaticResource LightRoundToolButtonStyle}">
                            <FontIcon FontSize="12" Glyph="&#xE72C;" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" Margin="2,6,2,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing
                            x:Name="LibraryProgressRing"
                            Width="13"
                            Height="13"
                            Margin="0,1,7,0"
                            VerticalAlignment="Top"
                            Foreground="{StaticResource AccentBrush}"
                            IsActive="False"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="LibraryStateText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{StaticResource MutedBrush}"
                            Text="Connect your reMarkable to browse files."
                            TextWrapping="Wrap" />
                    </Grid>

                    <ListView
                        x:Name="LibraryList"
                        Grid.Row="2"
                        MinHeight="108"
                        Margin="-6,0"
                        Background="Transparent"
                        Foreground="{StaticResource InkBrush}"
                        IsItemClickEnabled="True"
                        ItemClick="LibraryList_ItemClick"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="5,7">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem
                                                Click="SaveLibraryPdf_Click"
                                                IsEnabled="{Binding IsDocument}"
                                                Tag="{Binding}"
                                                Text="Save as PDF…">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8A5;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem
                                                Click="SaveLibraryNative_Click"
                                                IsEnabled="{Binding IsDocument}"
                                                Tag="{Binding}"
                                                Text="Save native RMDOC…">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE74E;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="28" Height="34" Background="#FFE0DFDA" CornerRadius="7">
                                        <FontIcon
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Foreground="{StaticResource InkBrush}"
                                            Glyph="{Binding Glyph}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
                                        <TextBlock
                                            MaxWidth="190"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource InkBrush}"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="10"
                                            Foreground="{StaticResource MutedBrush}"
                                            Text="{Binding KindLabel}" />
                                    </StackPanel>
                                    <FontIcon
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{StaticResource MutedBrush}"
                                        Glyph="{Binding ActionGlyph}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel
                        x:Name="TransferSection"
                        Grid.Row="3"
                        Margin="0,10,0,0"
                        Spacing="6"
                        Visibility="Collapsed">
                        <Grid>
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource InkBrush}"
                                Text="Recent transfers" />
                            <TextBlock
                                x:Name="QueueCountText"
                                HorizontalAlignment="Right"
                                FontSize="10"
                                Foreground="{StaticResource MutedBrush}"
                                Text="0 transfers" />
                        </Grid>
                        <ListView
                            x:Name="TransferList"
                            MaxHeight="106"
                            Margin="-6,0"
                            Background="Transparent"
                            Foreground="{StaticResource InkBrush}"
                            IsItemClickEnabled="False"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="5,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{StaticResource AccentBrush}"
                                            Glyph="&#xE898;" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock
                                                MaxWidth="210"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource InkBrush}"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="{StaticResource MutedBrush}"
                                                Text="{Binding State}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Border>
</UserControl>
