<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ReMarkableMirror.LibraryTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="5,5,5,20" Spacing="7">
        <Border Height="132" Background="#09000000" BorderBrush="#10000000" BorderThickness="1" CornerRadius="8">
            <Grid>
                <FontIcon
                    x:Name="KindIcon"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="31"
                    Foreground="#585858"
                    Glyph="&#xE8B7;" />
                <Border
                    x:Name="PageAccent"
                    Width="48"
                    Height="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,30"
                    Background="#B8B8B8"
                    CornerRadius="1" />
            </Grid>
        </Border>
        <TextBlock
            MaxWidth="120"
            FontSize="11"
            FontWeight="SemiBold"
            Foreground="#292929"
            Text="{x:Bind Title, Mode=OneWay}"
            TextTrimming="CharacterEllipsis" />
        <TextBlock
            Margin="0,-5,0,0"
            FontSize="9"
            Foreground="#808080"
            Text="{x:Bind Kind, Mode=OneWay}" />
    </StackPanel>
</UserControl>
