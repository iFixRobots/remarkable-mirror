<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ReMarkableMirror.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:files="using:ReMarkableMirror.Files"
    xmlns:local="using:ReMarkableMirror"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    IsTabStop="True"
    Loaded="Page_Loaded"
    LostFocus="Page_LostFocus"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#202124" />
        <SolidColorBrush x:Key="MutedBrush" Color="#5F6066" />
        <SolidColorBrush x:Key="StageBrush" Color="#EDECE7" />
        <SolidColorBrush x:Key="PaperBrush" Color="#FAF9F5" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3858E9" />

        <!-- Crisp, compact segmented control colors for the dark app chrome. -->
        <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#192537" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#0C1420" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonForeground" Color="#C8D0DC" />
        <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonForegroundDisabled" Color="#C8D0DC" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#F7F6F2" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#E9E7E1" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="#F7F6F2" />
        <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#17191C" />
        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#17191C" />
        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#17191C" />
        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedDisabled" Color="#17191C" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedDisabled" Color="Transparent" />

        <Style x:Key="RoundToolButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#FF212B3A" />
            <Setter Property="BorderBrush" Value="#FF3A4658" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="LightRoundToolButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="19" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="#FFE4E3DE" />
            <Setter Property="BorderBrush" Value="#FFC8C7C1" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="ModeButtonStyle" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="PrimaryConnectionButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="#1D2737" />
            <Setter Property="BorderBrush" Value="#1D2737" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Secondary actions stay visibly buttons: outlined, not bare text. -->
        <Style x:Key="QuietConnectionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#C9C9C4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#555961" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="66" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderMirrorRegion" Grid.Row="0" Padding="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <Border
                    Width="32"
                    Height="38"
                    Background="#FF1B2636"
                    BorderBrush="#FF354154"
                    BorderThickness="1"
                    CornerRadius="9">
                    <Grid Width="13.5" Height="24">
                        <Border
                            Background="#FFF7F6F2"
                            BorderBrush="#FF0D1117"
                            BorderThickness="1.3"
                            CornerRadius="2.5" />
                        <Border
                            Margin="2.2,3,2.2,3"
                            Background="#FFD9D8D2"
                            CornerRadius="0.5" />
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="0">
                    <TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="Paper Pro Move" />
                    <TextBlock
                        FontSize="11"
                        Foreground="#A8B1C0"
                        Text="Your reMarkable" />
                </StackPanel>
            </StackPanel>

            <Grid
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Border
                    x:Name="ModeSelector"
                    Padding="2"
                    Background="#FF111A27"
                    BorderBrush="#FF354154"
                    BorderThickness="1"
                    CornerRadius="11">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                    <ToggleButton
                        x:Name="TouchModeButton"
                        AutomationProperties.Name="Use mouse as touch; keyboard types automatically"
                        Click="ModeButton_Click"
                        IsChecked="True"
                        Style="{StaticResource ModeButtonStyle}"
                        Tag="Touch">
                        <TextBlock Text="Touch + Type" />
                    </ToggleButton>
                    <ToggleButton
                        x:Name="PenModeButton"
                        AutomationProperties.Name="Use mouse as pen"
                        Click="ModeButton_Click"
                        Style="{StaticResource ModeButtonStyle}"
                        Tag="Pen">
                        <TextBlock Text="Pen" />
                    </ToggleButton>
                    </StackPanel>
                </Border>

                <Border
                    x:Name="ActionToast"
                    MaxWidth="330"
                    MinHeight="42"
                    Padding="14,9"
                    Background="#FFF8F7F3"
                    BorderBrush="#FFD7D5CE"
                    BorderThickness="1"
                    CornerRadius="21"
                    Visibility="Collapsed">
                    <Grid ColumnSpacing="9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            x:Name="ActionToastIcon"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="{StaticResource InkBrush}"
                            Glyph="&#xE946;" />
                        <TextBlock
                            x:Name="ActionToastText"
                            Grid.Column="1"
                            MaxWidth="276"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource InkBrush}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
            </Grid>

            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <Button
                    x:Name="ConnectionRouteButton"
                    AutomationProperties.Name="Switch connection"
                    Click="ConnectionRouteButton_Click"
                    IsEnabled="False"
                    Padding="11,7"
                    Background="#FF202A39"
                    BorderBrush="#FF384457"
                    BorderThickness="1"
                    CornerRadius="18"
                    ToolTipService.ToolTip="Switch connection">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="#E2A33A" />
                        <TextBlock
                            x:Name="ConnectionText"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="Waiting for tablet" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="ScreenshotButton"
                    AutomationProperties.Name="Copy screenshot"
                    Click="ScreenshotButton_Click"
                    Style="{StaticResource RoundToolButtonStyle}"
                    ToolTipService.ToolTip="Copy screenshot • right-click to save">
                    <Button.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Click="ScreenshotSave_Click" Text="Save screenshot as…">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74E;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.ContextFlyout>
                    <FontIcon FontSize="16" Glyph="&#xE722;" />
                </Button>
                <Button
                    x:Name="FilesButton"
                    AutomationProperties.Name="Open files"
                    Click="FilesButton_Click"
                    Style="{StaticResource RoundToolButtonStyle}"
                    ToolTipService.ToolTip="Files">
                    <FontIcon FontSize="17" Glyph="&#xE8B7;" />
                </Button>
            </StackPanel>
        </Grid>

        <Border
            x:Name="StageSurface"
            Grid.Row="1"
            Margin="14,0,14,14"
            Background="{StaticResource StageBrush}"
            BorderBrush="#FFCFCFC9"
            BorderThickness="1"
            CornerRadius="24">
            <Grid
                x:Name="WorkspaceLayout"
                Background="{StaticResource StageBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TabletColumn" Width="*" />
                    <ColumnDefinition x:Name="FilesColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <files:FilesPaneView
                    x:Name="MainFilesPane"
                    Grid.Column="1"
                    VerticalAlignment="Stretch" />

            <Grid x:Name="TabletCanvas" Grid.Column="0">
                <Viewbox
                    Margin="20,16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    Stretch="Uniform"
                    StretchDirection="DownOnly"
                    UseLayoutRounding="True">
                    <Border
                        Width="978"
                        Height="1720"
                        Padding="12"
                        Background="#FF1D1D1F"
                        BorderBrush="#FF08090A"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Border
                            Width="954"
                            Height="1696"
                            Background="{StaticResource PaperBrush}"
                            CornerRadius="0">
                            <Grid x:Name="DeviceScreen" Background="Transparent">
                                <Grid x:Name="EmptyScreen" Background="#FFF7F6F1" />

                                <Image
                                    x:Name="LiveFrameImage"
                                    Width="954"
                                    Height="1696"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Stretch="Fill"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>
                    </Border>
                </Viewbox>

                <Border
                    x:Name="ConnectionPanel"
                    RequestedTheme="Light"
                    Width="360"
                    MaxWidth="360"
                    Margin="28"
                    Padding="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FFF8F7F3"
                    BorderBrush="#FFC9C7C0"
                    BorderThickness="1"
                    CornerRadius="18">
                    <StackPanel Spacing="0">
                        <Border
                            Width="42"
                            Height="42"
                            HorizontalAlignment="Left"
                            Background="#FFE6E8EF"
                            CornerRadius="12">
                            <Grid Width="13.5" Height="24">
                                <Border
                                    Background="#FFF8F7F3"
                                    BorderBrush="#FF25282D"
                                    BorderThickness="1.3"
                                    CornerRadius="2.4" />
                                <Border
                                    Margin="2.2,3,2.2,3"
                                    Background="#FFD7D6D0"
                                    CornerRadius="0.5" />
                            </Grid>
                        </Border>

                        <TextBlock
                            x:Name="ConnectionPanelTitle"
                            Margin="0,16,0,0"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource InkBrush}"
                            Text="Connect to your reMarkable" />
                        <TextBlock
                            x:Name="ConnectionPanelDetail"
                            Margin="0,7,0,0"
                            FontSize="13"
                            Foreground="{StaticResource MutedBrush}"
                            LineHeight="19"
                            Text="Choose USB-C or Wi-Fi. Mirror connects only after you select a connection."
                            TextWrapping="Wrap" />

                        <StackPanel Margin="0,18,0,0" Spacing="10">
                            <StackPanel
                                x:Name="ConnectionChoicePanel"
                                Orientation="Horizontal"
                                Spacing="6">
                                <Button
                                    x:Name="ConnectUsbButton"
                                    AutomationProperties.Name="Connect to your reMarkable over USB-C"
                                    Click="ConnectUsbButton_Click"
                                    Content="Connect USB-C"
                                    Style="{StaticResource PrimaryConnectionButtonStyle}" />
                                <Button
                                    x:Name="ConnectWifiButton"
                                    AutomationProperties.Name="Connect to your reMarkable over Wi-Fi"
                                    Click="ConnectWifiButton_Click"
                                    Content="Connect Wi-Fi"
                                    Style="{StaticResource QuietConnectionButtonStyle}" />
                            </StackPanel>

                            <StackPanel
                                x:Name="RestoreBackupPanel"
                                Orientation="Horizontal"
                                Spacing="6"
                                Visibility="Collapsed">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{StaticResource MutedBrush}"
                                    Text="Put a backup back on the tablet?" />
                                <Button
                                    x:Name="RestoreBackupButton"
                                    AutomationProperties.Name="Restore a document backup to the tablet"
                                    Click="RestoreBackupButton_Click"
                                    Content="Restore…"
                                    ToolTipService.ToolTip="Restore a document backup to the tablet"
                                    Style="{StaticResource QuietConnectionButtonStyle}" />
                            </StackPanel>

                            <StackPanel
                                x:Name="SetUpAgainPanel"
                                Orientation="Horizontal"
                                Spacing="6"
                                Visibility="Collapsed">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{StaticResource MutedBrush}"
                                    Text="Resetting or switching tablets?" />
                                <Button
                                    x:Name="SetUpAgainButton"
                                    AutomationProperties.Name="Open the setup walkthrough again"
                                    Click="SetUpAgainButton_Click"
                                    Content="Set Up Again…"
                                    Style="{StaticResource QuietConnectionButtonStyle}" />
                            </StackPanel>

                            <StackPanel
                                x:Name="WifiAddressPanel"
                                Spacing="7"
                                Visibility="Collapsed">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource InkBrush}"
                                    Text="Tablet Wi-Fi IP address" />
                                <TextBox
                                    x:Name="WifiAddressTextBox"
                                    AutomationProperties.Name="Tablet Wi-Fi IP address"
                                    KeyDown="WifiAddressTextBox_KeyDown"
                                    PlaceholderText="192.168.1.42" />
                                <TextBlock
                                    x:Name="WifiAddressValidationText"
                                    FontSize="12"
                                    Foreground="#FFB42318"
                                    TextWrapping="Wrap"
                                    Visibility="Collapsed" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button
                                        x:Name="SubmitWifiAddressButton"
                                        AutomationProperties.Name="Connect using this Wi-Fi IP address"
                                        Click="SubmitWifiAddressButton_Click"
                                        Content="Connect"
                                        Style="{StaticResource PrimaryConnectionButtonStyle}" />
                                    <Button
                                        x:Name="CancelWifiAddressButton"
                                        AutomationProperties.Name="Cancel Wi-Fi connection"
                                        Click="CancelWifiAddressButton_Click"
                                        Content="Cancel"
                                        Style="{StaticResource QuietConnectionButtonStyle}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel
                                x:Name="TabletSetupPanel"
                                Spacing="10"
                                Visibility="Collapsed">
                                <StackPanel
                                    x:Name="TabletSetupWalkthrough"
                                    Spacing="5"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        x:Name="WalkthroughStepCounter"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock
                                        x:Name="WalkthroughStepTitle"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource InkBrush}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="WalkthroughStepMessage"
                                        FontSize="12"
                                        Foreground="{StaticResource MutedBrush}"
                                        LineHeight="18"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="WalkthroughStepChecklist"
                                        FontSize="12"
                                        Foreground="{StaticResource InkBrush}"
                                        LineHeight="18"
                                        TextWrapping="Wrap"
                                        Visibility="Collapsed" />
                                    <TextBlock
                                        x:Name="WalkthroughBackupStatus"
                                        FontSize="12"
                                        Foreground="{StaticResource MutedBrush}"
                                        TextWrapping="Wrap"
                                        Visibility="Collapsed" />
                                    <StackPanel
                                        Margin="0,4,0,0"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <Button
                                            x:Name="WalkthroughBackButton"
                                            AutomationProperties.Name="Previous setup step"
                                            Click="WalkthroughBackButton_Click"
                                            Content="Back"
                                            Style="{StaticResource QuietConnectionButtonStyle}" />
                                        <Button
                                            x:Name="WalkthroughBackupButton"
                                            AutomationProperties.Name="Back up the tablet now"
                                            Click="WalkthroughBackupButton_Click"
                                            Content="Back Up Tablet"
                                            Style="{StaticResource PrimaryConnectionButtonStyle}" />
                                        <Button
                                            x:Name="WalkthroughSkipBackupButton"
                                            AutomationProperties.Name="Skip the backup"
                                            Click="WalkthroughContinueButton_Click"
                                            Content="Skip"
                                            Style="{StaticResource QuietConnectionButtonStyle}" />
                                        <Button
                                            x:Name="WalkthroughContinueButton"
                                            AutomationProperties.Name="Next setup step"
                                            Click="WalkthroughContinueButton_Click"
                                            Content="Continue"
                                            Style="{StaticResource PrimaryConnectionButtonStyle}" />
                                    </StackPanel>
                                    <StackPanel
                                        x:Name="WalkthroughSkipAheadPanel"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{StaticResource MutedBrush}"
                                            Text="Tablet already prepared?" />
                                        <Button
                                            x:Name="WalkthroughSkipAheadButton"
                                            AutomationProperties.Name="Skip to the final setup step"
                                            Click="WalkthroughSkipAheadButton_Click"
                                            Content="Skip Ahead"
                                            Style="{StaticResource QuietConnectionButtonStyle}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel
                                    x:Name="TabletSetupPasswordPanel"
                                    Spacing="7"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource InkBrush}"
                                        Text="One-time Developer Mode password" />
                                    <PasswordBox
                                        x:Name="TabletSetupPasswordBox"
                                        AutomationProperties.Name="One-time Developer Mode password"
                                        MaxLength="128"
                                        PasswordRevealMode="Peek"
                                        PlaceholderText="Enter the password shown on your tablet" />
                                </StackPanel>

                                <TextBlock
                                    x:Name="TabletSetupValidationText"
                                    FontSize="12"
                                    Foreground="#FFB42318"
                                    TextWrapping="Wrap"
                                    Visibility="Collapsed" />

                                <Button
                                    x:Name="TabletSetupNewTabletButton"
                                    AutomationProperties.Name="Forget the previous pairing and set up the connected tablet as new"
                                    Click="TabletSetupNewTabletButton_Click"
                                    Content="Set Up as New Tablet…"
                                    Style="{StaticResource QuietConnectionButtonStyle}"
                                    Visibility="Collapsed" />

                                <Button
                                    x:Name="TabletSetupPrimaryButton"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.Name="Start tablet setup"
                                    Click="TabletSetupPrimaryButton_Click"
                                    Content="Start Setup"
                                    Style="{StaticResource PrimaryConnectionButtonStyle}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button
                                    x:Name="CopyConnectionDetailsButton"
                                    AutomationProperties.Name="Copy connection details"
                                    Click="CopyConnectionDetailsButton_Click"
                                    Content="Copy details"
                                    Style="{StaticResource QuietConnectionButtonStyle}"
                                    Visibility="Collapsed" />
                                <ProgressRing
                                    x:Name="ConnectionProgressRing"
                                    Width="20"
                                    Height="20"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="#FF334052"
                                    IsActive="False"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            </Grid>
        </Border>

    </Grid>
</Page>
