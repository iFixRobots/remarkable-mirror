<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ReMarkableMirror.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:files="using:ReMarkableMirror.Files"
    xmlns:local="using:ReMarkableMirror"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    IsTabStop="True"
    Loaded="Page_Loaded"
    LostFocus="Page_LostFocus"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#202124" />
        <SolidColorBrush x:Key="MutedBrush" Color="#5F6066" />
        <SolidColorBrush x:Key="StageBrush" Color="#EDECE7" />
        <SolidColorBrush x:Key="PaperBrush" Color="#FAF9F5" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3858E9" />

        <!-- Crisp, compact segmented control colors for the dark app chrome. -->
        <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#192537" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#0C1420" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonForeground" Color="#C8D0DC" />
        <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonForegroundDisabled" Color="#C8D0DC" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#F7F6F2" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#E9E7E1" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="#F7F6F2" />
        <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#17191C" />
        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#17191C" />
        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#17191C" />
        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedDisabled" Color="#17191C" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedDisabled" Color="Transparent" />

        <Style x:Key="RoundToolButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#FF212B3A" />
            <Setter Property="BorderBrush" Value="#FF3A4658" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="LightRoundToolButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="19" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="#FFE4E3DE" />
            <Setter Property="BorderBrush" Value="#FFC8C7C1" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="ModeButtonStyle" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="PrimaryConnectionButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="#1D2737" />
            <Setter Property="BorderBrush" Value="#1D2737" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="QuietConnectionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#555961" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="66" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderMirrorRegion" Grid.Row="0" Padding="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <Border
                    Width="32"
                    Height="38"
                    Background="#FF1B2636"
                    BorderBrush="#FF354154"
                    BorderThickness="1"
                    CornerRadius="9">
                    <Grid Width="13.5" Height="24">
                        <Border
                            Background="#FFF7F6F2"
                            BorderBrush="#FF0D1117"
                            BorderThickness="1.3"
                            CornerRadius="2.5" />
                        <Border
                            Margin="2.2,3,2.2,3"
                            Background="#FFD9D8D2"
                            CornerRadius="0.5" />
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="0">
                    <TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="Paper Pro Move" />
                    <TextBlock
                        FontSize="11"
                        Foreground="#A8B1C0"
                        Text="Your reMarkable" />
                </StackPanel>
            </StackPanel>

            <Grid
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Border
                    x:Name="ModeSelector"
                    Padding="2"
                    Background="#FF111A27"
                    BorderBrush="#FF354154"
                    BorderThickness="1"
                    CornerRadius="11">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                    <ToggleButton
                        x:Name="TouchModeButton"
                        AutomationProperties.Name="Use mouse as touch; keyboard types automatically"
                        Click="ModeButton_Click"
                        IsChecked="True"
                        Style="{StaticResource ModeButtonStyle}"
                        Tag="Touch">
                        <TextBlock Text="Touch + Type" />
                    </ToggleButton>
                    <ToggleButton
                        x:Name="PenModeButton"
                        AutomationProperties.Name="Use mouse as pen"
                        Click="ModeButton_Click"
                        Style="{StaticResource ModeButtonStyle}"
                        Tag="Pen">
                        <TextBlock Text="Pen" />
                    </ToggleButton>
                    </StackPanel>
                </Border>

                <Border
                    x:Name="ActionToast"
                    MaxWidth="330"
                    MinHeight="42"
                    Padding="14,9"
                    Background="#FFF8F7F3"
                    BorderBrush="#FFD7D5CE"
                    BorderThickness="1"
                    CornerRadius="21"
                    Visibility="Collapsed">
                    <Grid ColumnSpacing="9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            x:Name="ActionToastIcon"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="{StaticResource InkBrush}"
                            Glyph="&#xE946;" />
                        <TextBlock
                            x:Name="ActionToastText"
                            Grid.Column="1"
                            MaxWidth="276"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource InkBrush}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>
            </Grid>

            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6">
                <Border
                    Padding="11,7"
                    Background="#FF202A39"
                    BorderBrush="#FF384457"
                    BorderThickness="1"
                    CornerRadius="18">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="#E2A33A" />
                        <TextBlock
                            x:Name="ConnectionText"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="Waiting for tablet" />
                    </StackPanel>
                </Border>
                <Button
                    x:Name="ScreenshotButton"
                    AutomationProperties.Name="Copy screenshot"
                    Click="ScreenshotButton_Click"
                    Style="{StaticResource RoundToolButtonStyle}"
                    ToolTipService.ToolTip="Copy screenshot • right-click to save">
                    <Button.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Click="ScreenshotSave_Click" Text="Save screenshot as…">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74E;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.ContextFlyout>
                    <FontIcon FontSize="16" Glyph="&#xE722;" />
                </Button>
                <Button
                    x:Name="FilesButton"
                    AutomationProperties.Name="Open files"
                    Click="FilesButton_Click"
                    Style="{StaticResource RoundToolButtonStyle}"
                    ToolTipService.ToolTip="Files">
                    <FontIcon FontSize="17" Glyph="&#xE8B7;" />
                </Button>
            </StackPanel>
        </Grid>

        <Border
            x:Name="StageSurface"
            Grid.Row="1"
            Margin="14,0,14,14"
            Background="{StaticResource StageBrush}"
            BorderBrush="#FFCFCFC9"
            BorderThickness="1"
            CornerRadius="24">
            <Grid
                x:Name="WorkspaceLayout"
                Background="{StaticResource StageBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TabletColumn" Width="*" />
                    <ColumnDefinition x:Name="FilesColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <files:FilesPaneView
                    x:Name="MainFilesPane"
                    Grid.Column="1"
                    VerticalAlignment="Stretch" />

            <Grid x:Name="TabletCanvas" Grid.Column="0">
                <Viewbox
                    Margin="20,16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    Stretch="Uniform"
                    StretchDirection="DownOnly"
                    UseLayoutRounding="True">
                    <Border
                        Width="978"
                        Height="1720"
                        Padding="12"
                        Background="#FF1D1D1F"
                        BorderBrush="#FF08090A"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Border
                            Width="954"
                            Height="1696"
                            Background="{StaticResource PaperBrush}"
                            CornerRadius="0">
                            <Grid x:Name="DeviceScreen" Background="Transparent">
                                <Grid x:Name="EmptyScreen" Background="#FFF7F6F1" />

                                <Image
                                    x:Name="LiveFrameImage"
                                    Width="954"
                                    Height="1696"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Stretch="Fill"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>
                    </Border>
                </Viewbox>

                <Border
                    x:Name="ConnectionPanel"
                    RequestedTheme="Light"
                    Width="360"
                    MaxWidth="360"
                    Margin="28"
                    Padding="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FFF8F7F3"
                    BorderBrush="#FFC9C7C0"
                    BorderThickness="1"
                    CornerRadius="18">
                    <StackPanel Spacing="0">
                        <Border
                            Width="42"
                            Height="42"
                            HorizontalAlignment="Left"
                            Background="#FFE6E8EF"
                            CornerRadius="12">
                            <Grid Width="13.5" Height="24">
                                <Border
                                    Background="#FFF8F7F3"
                                    BorderBrush="#FF25282D"
                                    BorderThickness="1.3"
                                    CornerRadius="2.4" />
                                <Border
                                    Margin="2.2,3,2.2,3"
                                    Background="#FFD7D6D0"
                                    CornerRadius="0.5" />
                            </Grid>
                        </Border>

                        <TextBlock
                            x:Name="ConnectionPanelTitle"
                            Margin="0,16,0,0"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource InkBrush}"
                            Text="Connect or wake your reMarkable" />
                        <TextBlock
                            x:Name="ConnectionPanelDetail"
                            Margin="0,7,0,0"
                            FontSize="13"
                            Foreground="{StaticResource MutedBrush}"
                            LineHeight="19"
                            Text="Press the power button once. Mirror reconnects over Wi-Fi when the tablet wakes. If Wi-Fi does not return, connect USB-C."
                            TextWrapping="Wrap" />

                        <StackPanel
                            Margin="0,18,0,0"
                            Orientation="Horizontal"
                            Spacing="4">
                            <Button
                                x:Name="ConnectionActionButton"
                                AutomationProperties.Name="Retry the tablet connection"
                                Click="ConnectionActionButton_Click"
                                Content="Retry"
                                Style="{StaticResource PrimaryConnectionButtonStyle}"
                                Visibility="Collapsed">
                                <Button.Resources>
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2A3649" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#111A27" />
                                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#D9D8D3" />
                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
                                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
                                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#73767D" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#2A3649" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#111A27" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#D9D8D3" />
                                </Button.Resources>
                            </Button>
                            <Button
                                x:Name="CopyConnectionDetailsButton"
                                AutomationProperties.Name="Copy connection details"
                                Click="CopyConnectionDetailsButton_Click"
                                Content="Copy details"
                                Style="{StaticResource QuietConnectionButtonStyle}"
                                Visibility="Collapsed">
                                <Button.Resources>
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E9E8E3" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#DCDAD3" />
                                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#30343A" />
                                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#202124" />
                                    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#9A9CA1" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                                </Button.Resources>
                            </Button>
                            <ProgressRing
                                x:Name="ConnectionProgressRing"
                                Width="20"
                                Height="20"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="#FF334052"
                                IsActive="False"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            </Grid>
        </Border>

    </Grid>
</Page>
