<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ReMarkableMirror.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ReMarkableMirror"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="reMarkable Mirror"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid Background="#FF000A23">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="reMarkable Mirror" Subtitle="Paper Pro Move" />

        <!--
            The Frame hosts pages for your application content. Add your UI to
            MainPage.xaml rather than here so you can use Page features such as
            navigation events and the Loaded lifecycle.
        -->
        <Frame
            x:Name="RootFrame"
            Grid.Row="1"
            HorizontalAlignment="Left" />
    </Grid>
</Window>
