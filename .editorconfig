root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,xaml,xml,ps1,psm1,cmd}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{cs,go,ps1,psm1,sh,yml,yaml,json,xml,xaml,md}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2
